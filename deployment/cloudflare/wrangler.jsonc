{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidekick",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/runtime/*", "/__sidekick/*"],
  },
  "observability": { "enabled": false },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatewayContainer", "TenantContainer"] }],
  "env": {
    "development": {
      "name": "sidekick-development",
      "vars": {
        "SIDEKICK_ENVIRONMENT": "development",
        "SIDEKICK_PUBLIC_URL": "https://sidekick-development.n8n-maintenance.workers.dev",
      },
      "triggers": { "crons": ["* * * * *"] },
      "durable_objects": {
        "bindings": [
          { "name": "GATEWAY", "class_name": "GatewayContainer" },
          { "name": "TENANTS", "class_name": "TenantContainer" },
        ],
      },
      "r2_buckets": [
        {
          "binding": "TENANT_FILES",
          "bucket_name": "sidekick-development-files",
          "jurisdiction": "eu",
        },
      ],
      "containers": [
        {
          "class_name": "GatewayContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 1,
          "constraints": { "jurisdiction": "eu" },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": { "logs": { "enabled": false } },
        },
        {
          "class_name": "TenantContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 8,
          "constraints": { "jurisdiction": "eu" },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": { "logs": { "enabled": false } },
        },
      ],
    },
    "production": {
      "name": "sidekick-production",
      "vars": {
        "SIDEKICK_ENVIRONMENT": "production",
        "SIDEKICK_PUBLIC_URL": "https://sidekick-production.n8n-maintenance.workers.dev",
      },
      "triggers": { "crons": ["* * * * *"] },
      "durable_objects": {
        "bindings": [
          { "name": "GATEWAY", "class_name": "GatewayContainer" },
          { "name": "TENANTS", "class_name": "TenantContainer" },
        ],
      },
      "r2_buckets": [
        {
          "binding": "TENANT_FILES",
          "bucket_name": "sidekick-production-files",
          "jurisdiction": "eu",
        },
      ],
      "containers": [
        {
          "class_name": "GatewayContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 1,
          "constraints": { "jurisdiction": "eu" },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": { "logs": { "enabled": false } },
        },
        {
          "class_name": "TenantContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 8,
          "constraints": { "jurisdiction": "eu" },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": { "logs": { "enabled": false } },
        },
      ],
    },
  },
}
