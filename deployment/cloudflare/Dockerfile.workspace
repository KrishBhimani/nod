FROM node:24.21.0-bookworm-slim AS helpers
WORKDIR /build
COPY src/providers/docker/command.ts ./src/providers/docker/command.ts
COPY src/providers/process.ts ./src/providers/process.ts
COPY src/ports/thread-identity.ts ./src/ports/thread-identity.ts
RUN node --experimental-transform-types --input-type=module -e 'import { writeFileSync } from "node:fs"; import { workspaceCommandProgram } from "./src/providers/docker/command.ts"; writeFileSync("/workspace-command.py", workspaceCommandProgram)'

FROM node:24.21.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python-is-python3 python3-pip python3-venv pipx ffmpeg poppler-utils ca-certificates curl git unzip tini \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/otto \
    && ln -s /home/node/state/workspace /workspace \
    && ln -s /home/node/state/tools /home/node/.local
COPY --from=helpers /workspace-command.py /opt/otto/workspace-command.py
COPY src/providers/cloudflare-computer/entrypoint.mjs /opt/otto/entrypoint.mjs
COPY src/providers/cloudflare-computer/checkpoint.py /opt/otto/checkpoint.py
RUN chmod 555 /opt/otto && chmod 444 /opt/otto/*
USER node
ENV NPM_CONFIG_PREFIX=/home/node/.local
ENV PIPX_HOME=/home/node/.local/pipx
ENV PIPX_BIN_DIR=/home/node/.local/bin
ENV PATH=/home/node/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /home/node
EXPOSE 4311
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/opt/otto/entrypoint.mjs"]
CMD ["workspace"]
