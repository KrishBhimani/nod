{
  "name": "sidekick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && node scripts/check-architecture.mjs && npm run format:check",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx src/server/index.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@chat-adapter/state-pg": "^4.41.0",
    "@chat-adapter/telegram": "^4.41.0",
    "@chat-adapter/whatsapp": "^4.41.0",
    "@composio/core": "0.21.0",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@fastify/middie": "^9.3.4",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@sinclair/typebox": "^0.34.41",
    "agent-browser": "0.38.1",
    "chat": "^4.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "pg-boss": "12.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
